<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="N6_QLKHO.Site" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: string.IsNullOrWhiteSpace(Page.Title) ? "Tổng Quan" : Page.Title %> - Quản Lý Kho N6</title>

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 Free -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <!-- Design System & Global Stylesheets (Minimalist Admin Theme) -->
    <link href="~/assets/css/main.css" rel="stylesheet" />
    <link href="~/assets/css/components.css" rel="stylesheet" />
    <link href="~/assets/css/responsive.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Overlay cho mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- 1. SIDEBAR -->
        <aside class="sidebar" id="sidebarNav">
            <div class="brand">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-boxes-stacked fs-5"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="d-flex align-items-center gap-2">
                        <span class="brand-title">QL KHO N6</span>
                        <span class="brand-pro-badge">PRO</span>
                    </div>
                    <small class="brand-subtitle text-truncate">Hệ Thống Quản Lý Kho</small>
                </div>
            </div>

            <!-- Sidebar Menu -->
            <div class="sidebar-scroll">

                <div class="menu-title">Tổng Quan</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" href="~/Dashboard.aspx" runat="server">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-chart-pie main-icon"></i>
                                <span>Dashboard</span>
                            </span>
                        </a>
                    </li>
                </ul>

                <div class="menu-title">Danh Mục &amp; Tồn Kho</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#danhmucSubmenu" role="button" aria-expanded="false" aria-controls="danhmucSubmenu">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-boxes-packing main-icon"></i>
                                <span>Danh Mục Cơ Bản</span>
                            </span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </a>
                        <div class="collapse" id="danhmucSubmenu">
                            <ul class="submenu flex-column">
                                <li class="nav-item">
                                    <a class="nav-link" href="~/HangHoa.aspx" runat="server">
                                        <i class="fa-solid fa-box me-2 opacity-75"></i> Hàng Hóa
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/LoaiHangHoa.aspx" runat="server">
                                        <i class="fa-solid fa-tags me-2 opacity-75"></i> Loại Hàng Hóa
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/NhaCungCap.aspx" runat="server">
                                        <i class="fa-solid fa-truck-field me-2 opacity-75"></i> Nhà Cung Cấp
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/TonKho.aspx" runat="server">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-warehouse main-icon"></i>
                                <span>Quản Lý Tồn Kho (Lô)</span>
                            </span>
                        </a>
                    </li>
                </ul>

                <div class="menu-title">Nghiệp Vụ Kho</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#khoSubmenu" role="button" aria-expanded="false" aria-controls="khoSubmenu">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-right-left main-icon"></i>
                                <span>Nhập &amp; Xuất Kho</span>
                            </span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </a>
                        <div class="collapse" id="khoSubmenu">
                            <ul class="submenu flex-column">
                                <li class="nav-item">
                                    <a class="nav-link" href="~/PhieuNhap.aspx" runat="server">
                                        <i class="fa-solid fa-file-arrow-down me-2 opacity-75"></i> Lập Phiếu Nhập
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/PhieuXuat.aspx" runat="server">
                                        <i class="fa-solid fa-file-arrow-up me-2 opacity-75"></i> Lập Phiếu Xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/LichSuKho.aspx" runat="server">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-clock-rotate-left main-icon"></i>
                                <span>Lịch Sử Nhập &amp; Xuất Kho</span>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/DonDatHang.aspx" runat="server">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-cart-shopping main-icon"></i>
                                <span>Đơn Đặt Hàng</span>
                            </span>
                        </a>
                    </li>
                </ul>

                <div class="menu-title">Hệ Thống &amp; Admin</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#adminSubmenu" role="button" aria-expanded="false" aria-controls="adminSubmenu">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-user-shield main-icon"></i>
                                <span>Quản Trị Hệ Thống</span>
                            </span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </a>
                        <div class="collapse" id="adminSubmenu">
                            <ul class="submenu flex-column">
                                <li class="nav-item">
                                    <a class="nav-link" href="~/QuanLyTaiKhoan.aspx" runat="server">
                                        <i class="fa-solid fa-users-gear me-2 opacity-75"></i> Quản Lý Tài Khoản
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="~/CaiDatHeThong.aspx" runat="server">
                                        <i class="fa-solid fa-sliders me-2 opacity-75"></i> Cài Đặt Hệ Thống
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/CanhBao.aspx" runat="server">
                            <span class="menu-icon-text">
                                <i class="fa-solid fa-triangle-exclamation main-icon"></i>
                                <span>Cảnh Báo Hạn Dụng</span>
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- 2. MAIN CONTENT AREA -->
        <main class="main-content">

            <header class="top-header">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-light border d-lg-none p-2" type="button" onclick="toggleSidebar()" aria-label="Mở menu">
                        <i class="fa-solid fa-bars fs-5"></i>
                    </button>
                    <div class="header-page-info">
                        <nav class="header-breadcrumb" aria-label="breadcrumb">
                            <a href="~/Dashboard.aspx" runat="server"><i class="fa-solid fa-house me-1"></i>Trang chủ</a>
                            <i class="fa-solid fa-chevron-right small opacity-50"></i>
                            <span class="text-primary fw-semibold"><%: string.IsNullOrWhiteSpace(Page.Title) ? "Tổng quan" : Page.Title %></span>
                        </nav>
                        <div class="header-page-title"><%: string.IsNullOrWhiteSpace(Page.Title) ? "Bảng Điều Khiển Tổng Quan" : Page.Title %></div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        <a href="#" class="user-badge dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar">
                                <i class="fa-solid fa-user-check"></i>
                            </span>
                            <span class="user-meta">
                                <span class="user-name"><%: Session["HoTen"] ?? "Quản Trị Viên" %></span>
                                <span class="user-role"><%: Session["ChucVu"] ?? "Quản lý kho" %></span>
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 py-2 rounded-3" aria-labelledby="dropdownUser1">
                            <li class="px-3 py-2 border-bottom d-sm-none">
                                <div class="fw-bold small text-dark"><%: Session["HoTen"] ?? "Quản Trị Viên" %></div>
                                <div class="text-muted small"><%: Session["ChucVu"] ?? "Quản lý kho" %></div>
                            </li>
                            <li><a class="dropdown-item py-2 px-3 small" href="~/QuanLyTaiKhoan.aspx" runat="server"><i class="fa-regular fa-id-badge me-2 text-primary"></i> Thông tin tài khoản</a></li>
                            <li><a class="dropdown-item py-2 px-3 small" href="~/CaiDatHeThong.aspx" runat="server"><i class="fa-solid fa-gear me-2 text-secondary"></i> Cài đặt hệ thống</a></li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li><a class="dropdown-item py-2 px-3 small text-danger fw-semibold" href="~/Login.aspx" runat="server"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="content-body">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>

            <footer class="app-footer">
                © <%: DateTime.Now.Year %> <strong>N6_QLKHO</strong> - Hệ Thống Quản Lý Kho Hàng Chuyên Nghiệp.
            </footer>
        </main>

    </form>

    <!-- Script tự động đánh dấu active menu đang truy cập -->
    <script>
        function toggleSidebar() {
            document.getElementById('sidebarNav').classList.toggle('show');
            document.getElementById('sidebarOverlay').classList.toggle('show');
        }

        document.addEventListener("DOMContentLoaded", function () {
            let currentPath = window.location.pathname.toLowerCase();
            if (currentPath === '/' || currentPath.endsWith('/default.aspx')) {
                currentPath = '/dashboard.aspx';
            }

            const currentFile = currentPath.split('/').pop() || 'dashboard.aspx';
            const navLinks = document.querySelectorAll('.sidebar .nav-link');
            navLinks.forEach(function (link) {
                const href = link.getAttribute('href');
                if (href && href !== '#' && !href.startsWith('#')) {
                    const linkFile = href.split('?')[0].replace(/^~\//, '').split('/').pop().toLowerCase();
                    if (currentFile === linkFile) {
                        link.classList.add('active');

                        const parentCollapse = link.closest('.collapse');
                        if (parentCollapse) {
                            parentCollapse.classList.add('show');
                            const toggleBtn = document.querySelector('[href="#' + parentCollapse.id + '"]');
                            if (toggleBtn) {
                                toggleBtn.setAttribute('aria-expanded', 'true');
                            }
                        }
                    }
                }
            });
        });
    </script>

    <script src='<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>'></script>
</body>
</html>
